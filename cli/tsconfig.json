{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // esbuild builds `dist`, so this project only checks.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // DOM as well as Node: the extractor's source is in this program, and the
    // bodies passed to page.evaluate run inside the browser.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
