{
  "name": "fit-to-figma",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Open a page in a headless browser, run the extractor, write the design tree to disk.",
  "engines": { "node": ">=24" },
  "bin": { "fit-to-figma": "./dist/bin.js" },
  "files": ["dist", "src"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build:extract && npm run build:bin",
    "build:extract": "esbuild ../packages/extract/src/global.ts --bundle --format=iife --platform=browser --target=es2022 --legal-comments=none --outfile=dist/extract.bundle.js",
    "build:bin": "esbuild src/bin.ts --bundle --platform=node --format=esm --target=node24 --external:puppeteer-core --external:esbuild --outfile=dist/bin.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fit-to-figma/extract": "^0.1.0",
    "@fit-to-figma/tree": "^0.1.0",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.11.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  }
}
